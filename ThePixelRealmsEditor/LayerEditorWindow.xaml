<Window x:Class="ThePixelRealmsEditor.LayerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layer"
        Width="420"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Layer neve"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="LayerNameTextBox"
                 Grid.Row="1"
                 Height="30"
                 Margin="0,0,0,14"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Layer értéke"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="LayerValueTextBox"
                     Height="30"/>

            <TextBlock Text="1.0 = teljes pályahossz, 0.2 = a pálya 20%-a"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Button x:Name="DeleteLayerButton"
                    Content="Layer törlése"
                    Width="110"
                    Height="32"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="DeleteLayerButton_Click"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Mégse"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

                <Button Content="Mentés"
                    Width="90"
                    Height="32"
                    Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
