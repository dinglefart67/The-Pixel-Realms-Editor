<Window x:Class="ThePixelRealmsEditor.ActionFramesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action szerkesztése"
        Width="1050" Height="520"
        MinWidth="760" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="ActionTitleText"
                       Text="ACTION SZERKESZTÉSE"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock Text="Adj hozzá PNG képkockákat. A nyilakkal változtathatod a sorrendet."
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,18"
                Background="#0D0F13"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FramesPanel"
                            Orientation="Horizontal"
                            Margin="15"
                            VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Képkockaidő (mp):"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="FrameDurationBox"
                         Width="75"/>
            </StackPanel>

            <TextBlock x:Name="FrameCountText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <Button Grid.Column="3"
                    Content="Mégse"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="4"
                    Content="Action mentése"
                    Width="155"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
