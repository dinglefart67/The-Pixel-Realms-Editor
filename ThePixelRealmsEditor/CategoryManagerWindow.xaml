<Window x:Class="ThePixelRealmsEditor.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset kategóriák"
        Width="700"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <StackPanel Margin="0,0,0,18">

            <TextBlock Text="ASSET KATEGÓRIÁK"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock Text="Az Asset Browser kategóriáinak és type-jainak kezelése."
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- CATEGORIES -->

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="KATEGÓRIÁK"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="CategoryListBox"
                         Grid.Row="1"
                         SelectionChanged="CategoryListBox_SelectionChanged"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <Grid Grid.Row="2"
                      Margin="0,8,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewCategoryTextBox"
                             Grid.Column="0"
                             Margin="0,0,5,0"/>

                    <Button Grid.Column="1"
                            Content="+"
                            Width="35"
                            Click="AddCategoryButton_Click"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="2"
                            Content="Törlés"
                            Click="DeleteCategoryButton_Click"/>

                </Grid>

            </Grid>


            <!-- TYPES -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="TYPE-OK"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="TypeListBox"
                         Grid.Row="1"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <Grid Grid.Row="2"
                      Margin="0,8,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTypeTextBox"
                             Grid.Column="0"
                             Margin="0,0,5,0"/>

                    <Button Grid.Column="1"
                            Content="+"
                            Width="35"
                            Click="AddTypeButton_Click"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="2"
                            Content="Törlés"
                            Click="DeleteTypeButton_Click"/>

                </Grid>

            </Grid>

        </Grid>


        <!-- CLOSE -->

        <Button Grid.Row="2"
                Content="Kész"
                HorizontalAlignment="Right"
                Padding="25,8"
                Margin="0,18,0,0"
                Click="CloseButton_Click"/>

    </Grid>

</Window>