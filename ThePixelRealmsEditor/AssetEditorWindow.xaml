<Window x:Class="ThePixelRealmsEditor.AssetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset"
        Width="580"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock x:Name="WindowTitleText"
                       Text="ASSET HOZZÁADÁSA"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock Text="Asset hozzáadása a The Pixel Realms Editor könyvtárához."
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- IMAGE -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="KÉP"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,8"/>

                <Border Width="210"
                        Height="210"
                        Background="#090B0E"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">

                    <Grid>

                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="8"/>

                        <TextBlock x:Name="NoImageText"
                                   Text="Nincs kiválasztott PNG"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <Button Content="PNG kiválasztása..."
                        Click="SelectImageButton_Click"
                        Margin="0,10,0,0"/>

                <TextBlock x:Name="SourceSizeText"
                           Text="Forrás: -"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,12,0,0"/>

                <TextBlock x:Name="GameSizeText"
                           Text="Játékban: -"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- DATA -->

            <StackPanel Grid.Column="2">

                <TextBlock Text="Név"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="NameTextBox"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Kategória"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="CategoryComboBox"
                          SelectionChanged="CategoryComboBox_SelectionChanged"
                          Margin="0,0,0,15"/>


                <TextBlock Text="Type"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="TypeComboBox"
                          Margin="0,0,0,20"/>


                <Border Background="#15181E"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">

                    <StackPanel>

                        <TextBlock Text="Méretkezelés"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="A PNG eredeti méretben kerül eltárolásra. A pályán az alapméret automatikusan a PNG szélessége és magassága osztva 16-tal."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>


        <!-- BOTTOM BUTTONS -->

        <Grid Grid.Row="2"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="DeleteButton"
                    Grid.Column="0"
                    Content="Asset törlése"
                    Click="DeleteButton_Click"
                    Visibility="Collapsed"
                    Padding="14,8"/>

            <Button Grid.Column="2"
                    Content="Mégse"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"
                    Padding="18,8"/>

            <Button Grid.Column="3"
                    Content="Mentés"
                    Click="SaveButton_Click"
                    Padding="18,8"/>

        </Grid>

    </Grid>

</Window>