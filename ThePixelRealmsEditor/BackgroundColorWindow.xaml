<Window x:Class="ThePixelRealmsEditor.BackgroundColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Háttérszín kiválasztása" Width="460" Height="580"
        MinWidth="430" MinHeight="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#20242C" Foreground="#ECEFF4">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151920"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="270"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Válassz háttérszínt" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#647084" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="ColorField" MouseLeftButtonDown="ColorField_MouseLeftButtonDown"
                      MouseMove="ColorField_MouseMove" MouseLeftButtonUp="ColorField_MouseLeftButtonUp"
                      SizeChanged="ColorField_SizeChanged" Cursor="Cross">
                    <Rectangle x:Name="HueBase" Fill="Red"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="FieldMarker" Width="14" Height="14" Stroke="White"
                             StrokeThickness="2" Fill="Transparent" HorizontalAlignment="Left"
                             VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Grid Grid.Column="2" x:Name="HueBar" Cursor="Hand"
                  MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                  MouseMove="HueBar_MouseMove" MouseLeftButtonUp="HueBar_MouseLeftButtonUp"
                  SizeChanged="HueBar_SizeChanged">
                <Rectangle Stroke="#647084" StrokeThickness="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Red" Offset="0"/>
                            <GradientStop Color="Yellow" Offset="0.166667"/>
                            <GradientStop Color="Lime" Offset="0.333333"/>
                            <GradientStop Color="Cyan" Offset="0.5"/>
                            <GradientStop Color="Blue" Offset="0.666667"/>
                            <GradientStop Color="Magenta" Offset="0.833333"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border x:Name="HueMarker" Height="6" BorderThickness="2" BorderBrush="White"
                        Background="#20242C" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="R" Margin="0,0,0,4"/>
                <TextBox x:Name="RedText" IsReadOnly="True" Focusable="False"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="G" Margin="0,0,0,4"/>
                <TextBox x:Name="GreenText" IsReadOnly="True" Focusable="False"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="B" Margin="0,0,0,4"/>
                <TextBox x:Name="BlueText" IsReadOnly="True" Focusable="False"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="HEX színkód" Margin="0,0,0,4"/>
                <TextBox x:Name="HexText" TextChanged="HexText_TextChanged" MaxLength="7"/>
            </StackPanel>
            <Border Grid.Column="2" x:Name="PreviewSwatch" BorderBrush="#647084" BorderThickness="1" CornerRadius="3"/>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="Mégse" DockPanel.Dock="Right" Click="Cancel_Click"/>
            <Button Content="Alkalmazás" DockPanel.Dock="Right" Click="Apply_Click" Background="#3976C7" Foreground="White"/>
        </DockPanel>
    </Grid>
</Window>
