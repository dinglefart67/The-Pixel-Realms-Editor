<Window x:Class="ThePixelRealmsEditor.MapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Pixel Realms Editor - Pályaszerkesztő"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENU -->

        <Border Grid.Row="0"
                Background="#0D0F13"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Menu Background="#0D0F13" Foreground="#E8ECF2">
                <Menu.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#20252E"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E8ECF2"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#343C49"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#E8ECF2"/>
                        <Setter Property="Background" Value="#20252E"/>
                        <Setter Property="BorderBrush" Value="#343C49"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="9,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#343C49"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <!-- Explicit submenu template avoids the bright Windows hover and thick default item border. -->
                    <Style x:Key="DarkDropdownItem" TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#E8ECF2"/>
                        <Setter Property="Background" Value="#20252E"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                            BorderThickness="0" Padding="13,7">
                                        <Grid MinWidth="180">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                              RecognizesAccessKey="True"/>
                                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                                       Foreground="#8994A5" Margin="24,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#343C49"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Background" Value="#363D49"/>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="Fájl">
                    <MenuItem Header="Új pálya" Style="{StaticResource DarkDropdownItem}" Click="NewMapMenu_Click"/>
                    <MenuItem Header="Pálya megnyitása" Style="{StaticResource DarkDropdownItem}" Click="OpenMapMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Mentés" Style="{StaticResource DarkDropdownItem}" InputGestureText="Ctrl+S" Click="SaveMapMenu_Click"/>
                    <MenuItem Header="Mentés másként" Style="{StaticResource DarkDropdownItem}" Click="SaveAsMapMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Vissza a főmenübe" Style="{StaticResource DarkDropdownItem}" Click="BackToMenu_Click"/>
                    <MenuItem Header="Kilépés" Style="{StaticResource DarkDropdownItem}" Click="ExitEditor_Click"/>
                </MenuItem>

                <MenuItem Header="Szerkesztés">
                    <MenuItem Header="Visszavonás" Style="{StaticResource DarkDropdownItem}" InputGestureText="Ctrl+Z" Click="UndoMenu_Click"/>
                    <MenuItem Header="Újra" Style="{StaticResource DarkDropdownItem}" InputGestureText="Ctrl+Y" Click="RedoMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Másolás" Style="{StaticResource DarkDropdownItem}" InputGestureText="Ctrl+C" Click="CopyMenu_Click"/>
                    <MenuItem Header="Kivágás" Style="{StaticResource DarkDropdownItem}" InputGestureText="Ctrl+X" Click="CutMenu_Click"/>
                    <MenuItem Header="Beillesztés" Style="{StaticResource DarkDropdownItem}" InputGestureText="Ctrl+V" Click="PasteMenu_Click"/>
                    <MenuItem Header="Törlés" Style="{StaticResource DarkDropdownItem}" InputGestureText="Delete" Click="DeleteMenu_Click"/>
                </MenuItem>
            </Menu>

        </Border>


        <!-- TOOLBAR -->

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">

            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button ToolTip="Visszavonás (Ctrl+Z)" Content="↶" FontSize="17"
                            Width="34" Height="28" Margin="0,0,5,0" Click="UndoMenu_Click"/>
                    <Button ToolTip="Újra (Ctrl+Y)" Content="↷" FontSize="17"
                            Width="34" Height="28" Margin="0,0,14,0" Click="RedoMenu_Click"/>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,14,2"/>
                    <CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True"
                              VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                              ToolTip="Objektumok automatikus illesztése" Margin="0,0,16,0"/>
                    <CheckBox x:Name="GridToggle" Content="Grid" IsChecked="True"
                              VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                              ToolTip="Szerkesztőrács megjelenítése"
                              Checked="GridToggle_Changed" Unchecked="GridToggle_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="CollisionsToggle" Content="Collisions" IsChecked="False"
                               VerticalAlignment="Center" Margin="0,0,18,0"
                               Foreground="{StaticResource TextBrush}"
                               Checked="CollisionsToggle_Changed" Unchecked="CollisionsToggle_Changed"/>
                    <CheckBox x:Name="ShowHudCheckBox" Content="HUD" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,18,0"
                              Foreground="{StaticResource TextBrush}"
                              Checked="ShowHudCheckBox_Changed" Unchecked="ShowHudCheckBox_Changed"/>
                    <TextBlock Text="Pálya:" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="ToolbarMapNameText" Text="Untitled" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </DockPanel>

        </Border>


        <!-- MAIN EDITOR -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="220"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT -->
            <!-- ================================================= -->

            <Grid Grid.Column="0"
                  Background="{StaticResource PanelBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ASSET BROWSER -->

                <Grid Grid.Row="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#15181E"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12">

                        <TextBlock Text="ASSET BROWSER"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>

                    </Border>

                    <Grid Grid.Row="1"
                          Margin="10,10,10,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="+ Asset"
                                Click="AddAssetButton_Click"/>

                        <Button Grid.Column="2"
                                Content="Kategóriák"
                                Click="CategoriesButton_Click"/>

                    </Grid>

                    <TextBox x:Name="AssetSearchTextBox"
                             Grid.Row="2"
                             Margin="10"
                             TextChanged="AssetSearchTextBox_TextChanged"/>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="AssetBrowserPanel"
                                    Margin="10,0,10,10"/>

                    </ScrollViewer>

                </Grid>


                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="#0D0F13"/>


                <!-- LAYERS -->

                <Grid Grid.Row="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#15181E"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="12">

                        <DockPanel>

                            <Button Content="+"
                                    Width="28"
                                    Height="24"
                                    Padding="0"
                                    DockPanel.Dock="Right"
                                    Click="AddLayerButton_Click"/>

                            <TextBlock Text="LAYERS"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"/>

                        </DockPanel>

                    </Border>

                    <ComboBox x:Name="OtherLayersVisibilityComboBox"
                              Grid.Row="1"
                              SelectedIndex="1"
                              Margin="10,8,10,6"
                              Foreground="Black"
                              SelectionChanged="OtherLayersVisibilityComboBox_SelectionChanged">
                        <ComboBoxItem Content="Többi layer mutatása"/>
                        <ComboBoxItem Content="Többi layer halványan mutatása"/>
                        <ComboBoxItem Content="Többi layer eltüntetése"/>
                    </ComboBox>

                    <ListBox x:Name="LayersListBox"
                             Grid.Row="2"
                             Background="{StaticResource PanelBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="LayersListBox_SelectionChanged"/>

                </Grid>

            </Grid>


            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#0D0F13"/>


            <!-- ================================================= -->
            <!-- VIEWPORT -->
            <!-- ================================================= -->

            <Grid Grid.Column="2"
                  x:Name="ViewportContainer"
                  Background="#090B0E">

                <!--
                    ScrollBar csak akkor jelenik meg,
                    ha ténylegesen szükséges.
                -->

                <ScrollViewer x:Name="MapScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              Background="#090B0E"
                              ScrollChanged="MapScrollViewer_ScrollChanged"
                              PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">

                    <Grid x:Name="WorldContainer"
                          Width="5000"
                          Height="1080"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="WorldZoomTransform"
                                            ScaleX="1"
                                            ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <!-- MAP BACKGROUND / GRID -->

                        <Rectangle x:Name="MapBackgroundRectangle" Fill="#101318" IsHitTestVisible="False"/>
                        <!-- Külön rácsréteg: a háttérszíntől függetlenül ki/be kapcsolható. -->
                        <Rectangle x:Name="MapGridOverlay" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile"
                                              Viewport="0,0,32,32"
                                              ViewportUnits="Absolute">

                                    <DrawingBrush.Drawing>

                                        <GeometryDrawing Brush="Transparent">

                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#1C222A"
                                                     Thickness="1"/>
                                            </GeometryDrawing.Pen>

                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,32,32"/>
                                            </GeometryDrawing.Geometry>

                                        </GeometryDrawing>

                                    </DrawingBrush.Drawing>

                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>


                        <!-- OBJECTS -->

                        <Canvas x:Name="WorldCanvas"
                                Width="5000"
                                Height="1080"
                                Background="Transparent"
                                AllowDrop="True"
                                DragEnter="WorldCanvas_DragMove"
                                DragOver="WorldCanvas_DragMove"
                                DragLeave="WorldCanvas_DragLeave"
                                Drop="WorldCanvas_Drop"
                                PreviewMouseLeftButtonDown="WorldCanvas_PreviewMouseLeftButtonDown"/>


                        <!-- DROP PREVIEW -->

                        <Border x:Name="DropPreview"
                                Visibility="Collapsed"
                                Opacity="0.55"
                                BorderBrush="White"
                                BorderThickness="1"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Panel.ZIndex="20000">

                            <Image x:Name="DropPreviewImage"
                                   Stretch="Fill"/>

                        </Border>



                        <!-- Játékbeli HUD / keret előnézet -->
                        <Grid x:Name="GameHudPreview"
                              Visibility="Collapsed"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Panel.ZIndex="200000"
                              ClipToBounds="True">

                            <Grid x:Name="GameHudBorder"
                                  Margin="0,0,0,158">

                                <Image Source="Assets/GameBorder/Border_topleft.png"
                                       Width="48" Height="48"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Border_topright.png"
                                       Width="48" Height="48"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Border_bottomleft.png"
                                       Width="48" Height="48"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Border_bottomright.png"
                                       Width="48" Height="48"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Line_top.png"
                                       Height="24"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Top"
                                       Margin="48,0,48,0"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Line_bottom.png"
                                       Height="24"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       Margin="48,0,48,0"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Line_left.png"
                                       Width="24"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch"
                                       Margin="0,48,0,48"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Line_right.png"
                                       Width="24"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Margin="0,48,0,48"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>

                            <Grid x:Name="GameHudBottomPanel"
                                  Height="168"
                                  VerticalAlignment="Bottom">

                                <Image Source="Assets/GameBorder/Hud_border_left.png"
                                       Width="168" Height="168"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Hud_border_right.png"
                                       Width="168" Height="168"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <Image Source="Assets/GameBorder/Hud_border_middle.png"
                                       Height="168"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       Margin="168,0,168,0"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Grid>

                        <!-- MAP BOUNDARY -->

                        <Border x:Name="MapBoundaryBorder"
                                Width="5000"
                                Height="1080"
                                BorderBrush="White"
                                BorderThickness="1"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Panel.ZIndex="30000"/>

                    </Grid>

                </ScrollViewer>


                <!-- EMPTY MESSAGE -->

                <StackPanel x:Name="EmptyViewportMessage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">

                    <TextBlock Text="MAP VIEWPORT"
                               HorizontalAlignment="Center"
                               Foreground="#353B45"
                               FontSize="26"
                               FontWeight="Bold"/>

                    <TextBlock Text="Húzz ide egy assetet az Asset Browserből"
                               HorizontalAlignment="Center"
                               Foreground="#292F38"
                               FontSize="12"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>


            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#0D0F13"/>


            <!-- ================================================= -->
            <!-- INSPECTOR -->
            <!-- ================================================= -->

            <Grid Grid.Column="4"
                  Background="{StaticResource PanelBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#15181E"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12">

                    <TextBlock Text="INSPECTOR"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                </Border>


                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="14">

                        <TextBlock x:Name="InspectorSelectionText"
                                   Text="Nincs kijelölt objektum"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,20"/>


                        <!-- OBJECT TRANSFORM -->

                        <TextBlock Text="TRANSFORM"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="X"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="ObjectXTextBox"
                                 Text="0"
                                 IsEnabled="False"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Y"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="ObjectYTextBox"
                                 Text="0"
                                 IsEnabled="False"
                                 Margin="0,0,0,10"/>


                        <TextBlock Text="Szélesség"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="ObjectWidthTextBox"
                                 Text="0"
                                 IsEnabled="False"
                                 Margin="0,0,0,5"/>

                        <ComboBox x:Name="WidthModeComboBox"
                                  IsEnabled="False"
                                  SelectedIndex="0"
                                  Margin="0,0,0,12">

                            <ComboBoxItem Content="Nyújtás"/>
                            <ComboBoxItem Content="Ismétlés"/>

                        </ComboBox>


                        <TextBlock Text="Magasság"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="ObjectHeightTextBox"
                                 Text="0"
                                 IsEnabled="False"
                                 Margin="0,0,0,5"/>

                        <ComboBox x:Name="HeightModeComboBox"
                                  IsEnabled="False"
                                  SelectedIndex="0"
                                  Margin="0,0,0,14">

                            <ComboBoxItem Content="Nyújtás"/>
                            <ComboBoxItem Content="Ismétlés"/>

                        </ComboBox>


                        <CheckBox x:Name="KeepAspectRatioCheckBox"
                                  Content="Méretarány megtartása"
                                  IsChecked="False"
                                  IsEnabled="False"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,14"/>


                        <Button x:Name="ApplyObjectButton"
                                Content="Objektum alkalmazása"
                                Height="34"
                                IsEnabled="False"
                                Click="ApplyObjectButton_Click"/>


                        <Separator Margin="0,18"/>


                        <!-- COLLISION EDITOR -->
                        <TextBlock Text="COLLISION" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Ctrl + kattintás: több objektum kijelölése"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                        <Grid x:Name="CollisionEditorPanel" IsEnabled="False" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="108"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="CollisionTopCheck" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"
                                      Checked="CollisionCheck_Changed" Unchecked="CollisionCheck_Changed"/>
                            <CheckBox x:Name="CollisionLeftCheck" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Checked="CollisionCheck_Changed" Unchecked="CollisionCheck_Changed"/>
                            <CheckBox x:Name="CollisionRightCheck" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Checked="CollisionCheck_Changed" Unchecked="CollisionCheck_Changed"/>
                            <CheckBox x:Name="CollisionBottomCheck" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"
                                      Checked="CollisionCheck_Changed" Unchecked="CollisionCheck_Changed"/>
                            <Canvas x:Name="CollisionDiagram" Grid.Row="1" Grid.Column="1" Background="#242D39" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel x:Name="CollisionSlidersPanel" Margin="0,0,0,10" IsEnabled="False">
                            <TextBlock x:Name="CollisionTopLabel" Text="Felső: 0–100%" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,2"/>
                            <Canvas x:Name="CollisionTopSlider" Height="26" Background="Transparent" Tag="Top"
                                    SizeChanged="CollisionSlider_SizeChanged"
                                    MouseLeftButtonDown="CollisionSlider_MouseDown"
                                    MouseMove="CollisionSlider_MouseMove"
                                    MouseLeftButtonUp="CollisionSlider_MouseUp"/>
                            <TextBlock x:Name="CollisionRightLabel" Text="Jobb: 0–100%" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,2"/>
                            <Canvas x:Name="CollisionRightSlider" Height="26" Background="Transparent" Tag="Right"
                                    SizeChanged="CollisionSlider_SizeChanged"
                                    MouseLeftButtonDown="CollisionSlider_MouseDown"
                                    MouseMove="CollisionSlider_MouseMove"
                                    MouseLeftButtonUp="CollisionSlider_MouseUp"/>
                            <TextBlock x:Name="CollisionBottomLabel" Text="Alsó: 0–100%" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,2"/>
                            <Canvas x:Name="CollisionBottomSlider" Height="26" Background="Transparent" Tag="Bottom"
                                    SizeChanged="CollisionSlider_SizeChanged"
                                    MouseLeftButtonDown="CollisionSlider_MouseDown"
                                    MouseMove="CollisionSlider_MouseMove"
                                    MouseLeftButtonUp="CollisionSlider_MouseUp"/>
                            <TextBlock x:Name="CollisionLeftLabel" Text="Bal: 0–100%" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,2"/>
                            <Canvas x:Name="CollisionLeftSlider" Height="26" Background="Transparent" Tag="Left"
                                    SizeChanged="CollisionSlider_SizeChanged"
                                    MouseLeftButtonDown="CollisionSlider_MouseDown"
                                    MouseMove="CollisionSlider_MouseMove"
                                    MouseLeftButtonUp="CollisionSlider_MouseUp"/>
                        </StackPanel>
                        <Separator Margin="0,18"/>

                        <!-- OBJECTS -->

                        <TextBlock Text="OBJECTS"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Lerakott objektumok layerenként"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,0,0,8"/>

                        <TreeView x:Name="PlacedObjectsTreeView"
                                  Height="250"
                                  Background="#11141A"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  Foreground="{StaticResource TextBrush}"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="PlacedObjectsTreeView_PreviewMouseLeftButtonDown"
                                  SelectedItemChanged="PlacedObjectsTreeView_SelectedItemChanged"
                                  PreviewMouseMove="PlacedObjectsTreeView_PreviewMouseMove"
                                  DragOver="PlacedObjectsTreeView_DragOver"
                                  Drop="PlacedObjectsTreeView_Drop"
                                  Margin="0,0,0,12">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="#263244"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                 Color="#263244"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                 Color="#E6E6E6"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                                 Color="#E6E6E6"/>

                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Padding"
                                            Value="4,3"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#263244"/>
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource TextBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.Resources>
                        </TreeView>

                        <Separator Margin="0,18"/>


                        <!-- MAP SETTINGS -->

                        <TextBlock Text="MAP SETTINGS"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Pálya neve"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="MapNameTextBox" Text="Untitled"
                                 TextChanged="MapNameTextBox_TextChanged" Margin="0,0,0,12"/>


                        <TextBlock Text="Grid méret"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="GridSizeComboBox" SelectedIndex="2"
                                  Margin="0,0,0,12">

                            <ComboBoxItem Content="8 px"/>
                            <ComboBoxItem Content="16 px"/>
                            <ComboBoxItem Content="32 px"/>
                            <ComboBoxItem Content="64 px"/>

                        </ComboBox>


                        <TextBlock Text="Háttérszín beállítása"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <Button x:Name="BackgroundColorButton"
                                Width="36" Height="36"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"
                                Padding="3"
                                Click="BackgroundColorButton_Click"
                                ToolTip="Háttérszín kiválasztása">
                            <Border x:Name="BackgroundColorSwatch"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"/>
                        </Button>

                        <TextBlock Text="Pálya szélessége"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="MapWidthTextBox"
                                 Text="5000"
                                 Margin="0,0,0,12"/>


                        <TextBlock Text="Pálya magassága"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="MapHeightTextBox"
                                 Text="1080"
                                 Margin="0,0,0,14"/>


                        <Button Content="Alkalmazás"
                                Height="34"
                                Click="ApplyMapSettingsButton_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>


        <!-- STATUS -->

        <Border Grid.Row="3"
                Background="#0D0F13"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Text="Kész"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="CursorPositionText"
                               Text="X: 0   Y: 0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBlock Text="Zoom:"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ComboBox x:Name="ZoomComboBox"
                              Width="78"
                              Height="24"
                              SelectedIndex="3"
                              SelectionChanged="ZoomComboBox_SelectionChanged">
                        <ComboBoxItem Content="50%" Tag="0.5"/>
                        <ComboBoxItem Content="75%" Tag="0.75"/>
                        <ComboBoxItem Content="90%" Tag="0.9"/>
                        <ComboBoxItem Content="100%" Tag="1.0"/>
                        <ComboBoxItem Content="125%" Tag="1.25"/>
                        <ComboBoxItem Content="150%" Tag="1.5"/>
                        <ComboBoxItem Content="200%" Tag="2.0"/>
                    </ComboBox>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>